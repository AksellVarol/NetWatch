<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.aksell.netwatch" android:versionCode="32" android:versionName="2.9.8">
<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34"/>
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<!-- v2.9.6: legacy report exports (API 21-28) write to the public
     Downloads/NetWatch folder. API 29+ uses MediaStore and never needs it. -->
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
<application android:name=".NetWatchApp" android:label="NetWatch" android:icon="@drawable/netwatch_icon" android:theme="@android:style/Theme.Material.NoActionBar">
<activity android:name=".MainActivity" android:exported="true">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity>
<receiver android:name=".NetWatchWidget" android:exported="true" android:label="NetWatch">
<intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
<meta-data android:name="android.appwidget.provider" android:resource="@xml/netwatch_widget_info"/>
</receiver>
<activity android:name=".GamingActivity" android:exported="false"/>
<activity android:name=".LabActivity" android:exported="false"/>
<!-- v2.9.6: minimal read-only provider for legacy (API 21-28) report
     exports in Downloads/NetWatch. No androidx FileProvider exists in
     this project (zero dependencies). API 29+ never uses it. -->
<provider android:name=".ExportFileProvider" android:authorities="com.aksell.netwatch.exports" android:exported="false" android:grantUriPermissions="true"/>
<service android:name=".MonitorService" android:foregroundServiceType="dataSync" android:exported="false"/>
</application>
</manifest>
